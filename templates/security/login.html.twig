{% extends 'base.html.twig' %}

{% block title %}Connexion
{% endblock %}

{% block body %}

	<main class="w-full flex flex-col items-center p-9">
		<div class="w-[40%] flex flex-col items-center gap-7">
			<div>
				<h1 class="text-white font-bold text-center text-2xl">Se connecter</h1>
			</div>

			<form method="post" class="flex flex-col gap-4 w-full text-[16px] items-center">
				<div class="flex flex-col gap-4 w-full">
					<div class="flex flex-row justify-between">
						<label class="text-white font-semibold" for="username">Email :</label>
						<input class="rounded-md px-2 focus:border focus:border-blue-500" type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus placeholder="Entrez votre email">
					</div>
					<div class="flex flex-row justify-between">
						<label class="text-white font-semibold" for="password">Mot de passe :</label>
						<input class="rounded-md px-2 focus:border focus:border-blue-500" type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required placeholder="Entrez votre email">
					</div>

					<input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
				</div>
				{% if error %}
					<div class="text-red-600 bg-red-400 bg:opacity-50 border-2 border-red-500 py-1 px-2">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
				{% endif %}

				<button class="rounded-md text-white bg-blue-500 w-30 p-2 font-semibold focus:outline-none focus:scale-105 hover:scale-105" type="submit">
					Se connecter
				</button>
			</form>

			<div class="w-[80%] border border-white"></div>
			<p class="text-white text-[12px]">Pas encore de compte ?
				<a class=" hover:text-blue-500 focus:text-blue-00 hover:font-bold focus:font-bold focus:outline-none" href="{{ path('app_register')}}">inscris-toi</a>
			</p>
		</div>
	</main>
{% endblock %}
