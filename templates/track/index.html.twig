{% extends 'base.html.twig' %}

{% block title %}Home
{% endblock %}

{% block body %}
	<main class="p-9">
		<div class="main-container flex flex-col w-full gap-9">
			<div>
				{% include "_partials/_button.html.twig" with {
				class: 'add-track-btn',
				title: 'Ajouter une track',
				bg: 'bg-blue-500'
			}
			%}
			</div>


			<div class="tracks-container flex flex-row justify-center flex-wrap gap-6">
				{% for wishListTrack in WishListTracks %}

