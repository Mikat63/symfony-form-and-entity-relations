{% extends 'base.html.twig' %}

{% block title %}Home
{% endblock %}

{% block body %}

	{% include "_partials/_header.html.twig" %}

	<main class="p-9">

		<div class="tracks-container flex flex-row flex-wrap gap-9">
			{% for wishListTrack in WishListTracks %}
				<div class="flex flex-col gap-2 bg-gray-500 rounded-xl p-4 w-[30%] h-auto">
					<p class="text-white text-[28px] font-bold">
						{{wishListTrack.name}}
					</p>

					<div class="flex flex-col text-white text-[24px]">
						<p>
							{% for artist in wishListTrack.artists %}
								{{artist.name}}
								{% if not loop.last %},
								{% endif %}

							{% endfor %}
						</p>
					</div>

					<div class=" flex flex-row gap-2 text-white text-[24px]">
						<p>{{wishListTrack.album.name}}
						</p>

						<p>{{wishListTrack.album.year}}</p>
					</div>


					<div class="flex flex-col text-white text-[24px]">
						<p>
							{% for genre in wishListTrack.genres %}
								{{genre.name}}
								{% if not loop.last %},
								{% endif %}

							{% endfor %}
						</p>
					</div>
				</div>


			{% endfor %}
		</main>
	{% endblock %}
