{% extends 'base.html.twig' %}

{% block title %}Home
{% endblock %}

{% block body %}

	{% include "_partials/_header.html.twig" %}

	<main class="p-9">

		<div class="main-container flex flex-col w-full gap-9">
			<div>
				{% include "_partials/_button.html.twig" with {
				class: 'add-track-btn',
				title: 'Ajouter une track',
				bg: 'bg-blue-500'
			}
			%}
			</div>


			<div class="tracks-container flex flex-row justify-center flex-wrap gap-6">
				{% for wishListTrack in WishListTracks %}

					{% include "_partials/_trackCard.html.twig" %}

				{% endfor %}
			</div>
		</main>
		<div class="form-modal fixed z-10 w-[80%] h-[400px] bg-gray-300 left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 "></div>
	{% endblock %}
