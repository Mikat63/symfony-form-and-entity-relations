<dialog aria-modal="true" class="form-modal
		fixed left-1/2 top-1/2 -translate-x-1/4 -translate-y-1/4
		w-[80%]  bg-gray-300 p-4
		max-h-none overflow-visible
		flex flex-col gap-9 items-center sm:w-[50%] xl:w-[30%] 2xl:w-[20%]">
	<h2 id="form-title-modal" class="w-full text-[24px] text-black  text-center font-bold"></h2>

	<div class="w-[80%]">
		{{form_start(trackForm, {'attr': {'class': 'flex flex-col gap-2'}})}}
		<div class=" w-full flex flex-col justify-between gap-2">
			{{form_label(trackForm.name, 'Titre :', {'label_attr': {'class': 'font-semibold text-black text-[20px]' } })}}
			{{form_widget(trackForm.name, {'attr': {'class': 'bg-white rounded-sm px-2', 'required': true, 'placeholder': 'Entrez un titre', 'minLength': 3, 'maxlength': 255}})}}
			{{form_errors(trackForm.name, {'attr': {'class': 'text-red-500 font-bold text-[16px]'}})}}
		</div>

		<div class="flex flex-col justify-between gap-2">
			{{form_label(trackForm.artists, 'Artiste :', {'label_attr': {'class': 'font-semibold text-black text-[20px]' } })}}
			{{form_widget(trackForm.artists, {'attr': {'class': 'bg-white rounded-sm px-2','required': true, 'placeholder': 'Entrez un artiste','minLength': 3, 'maxlength': 255}})}}
			{{form_errors(trackForm.artists, {'attr': {'class': 'text-red-500 font-bold text-[16px]'}})}}
		</div>

		<div class="flex flex-col justify-between gap-2">
			{{form_label(trackForm.album, 'Album :', {'label_attr': {'class': 'font-semibold text-black text-[20px]' } })}}
			{{form_widget(trackForm.album, {'attr': {'class': 'bg-white rounded-sm px-2','required': false, 'placeholder': 'Entrez un album','minLength': 3, 'maxlength': 255}})}}
			{{form_errors(trackForm.album, {'attr': {'class': 'text-red-500 font-bold text-[16px]'}})}}

		</div>

		<div class="flex flex-col justify-between gap-2">
			{{form_label(trackForm.year, 'Année :', {'label_attr': {'class': 'font-semibold text-black text-[20px]' } })}}
			{{form_widget(trackForm.year, {'attr': {'class': 'bg-white rounded-sm px-2','required': false, 'placeholder': "Entrez l'année de sortie",'minLength': 4, 'maxlength': 4}})}}
			{{form_errors(trackForm.year, {'attr': {'class': 'text-red-500 font-bold text-[16px]'}})}}

		</div>

		<div class="flex flex-col justify-between gap-2">
			{{form_label(trackForm.genres, 'Genre :', {'label_attr': {'class': 'font-semibold text-black text-[20px]' } })}}
			{{form_widget(trackForm.genres, {'attr': {'class': 'bg-white rounded-sm px-2','required': true, 'placeholder': 'Entrez un genre','minLength': 3, 'maxlength': 50}})}}
			{{form_errors(trackForm.genres, {'attr': {'class': 'text-red-500 font-bold text-[16px]'}})}}

		</div>

		<div class="flex flex-row justify-center gap-2 pt-6">
			{% include "_partials/_button-submit.html.twig" with {
					title: "Valider",
					bg: "bg-blue-500",
					class: "submit-btn"
				 } %}

			{% include "_partials/_button.html.twig" with {
				class: 'cancel-btn',
				title: 'Annuler',
				bg: 'bg-gray-500'
			}%}
		</div>
		{{form_end(trackForm)}}
	</div>

</dialog>
